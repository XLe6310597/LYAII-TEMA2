<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="aldrichsystems.menu2.MenuController"
            prefWidth="1100" prefHeight="720">
    <top>
        <HBox spacing="14"
              style="-fx-background-color: linear-gradient(to right, #2c3e50, #4ca1af); -fx-alignment: center-left;">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>

            <Label text="Panel de Proyectos"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <left>
        <VBox BorderPane.alignment="CENTER"
              style="-fx-background-color: #f7f8fa; -fx-border-color: #e6e9ef; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="16" right="12" bottom="16" left="12"/>
            </padding>
            <Label text="Proyectos"
                   style="-fx-text-fill: #2c3e50; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 0 0 10 2;"/>
            <ScrollPane fitToWidth="true" prefWidth="270"
                        style="-fx-background-color: transparent;">
                <content>
                    <VBox spacing="8" fillWidth="true">
                        <!-- Botones que abren cada proyecto -->
                        <Button text="Proyecto 1" maxWidth="Infinity" onAction="#abrirProyecto1"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                        <Button text="Proyecto 2" maxWidth="Infinity" onAction="#abrirProyecto2"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                        <Button text="Proyecto 3" maxWidth="Infinity" onAction="#abrirProyecto3"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                        <Button text="Proyecto 4" maxWidth="Infinity" onAction="#abrirProyecto4"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                        <Button text="Proyecto 5" maxWidth="Infinity" onAction="#abrirProyecto5"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                        <Button text="Proyecto 6" maxWidth="Infinity" onAction="#abrirProyecto6"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                        <Button text="Proyecto 7" maxWidth="Infinity" onAction="#abrirProyecto7"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                        <Button text="Proyecto 8" maxWidth="Infinity" onAction="#abrirProyecto8"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                        <Button text="Proyecto 9" maxWidth="Infinity" onAction="#abrirProyecto9"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                        <Button text="Proyecto 10" maxWidth="Infinity" onAction="#abrirProyecto10"
                                style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-background-radius: 10; -fx-padding: 10 12; -fx-border-color: #e5e7eb; -fx-border-radius: 10;"/>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </left>
    <!-- CONTENIDO CENTRAL -->
    <center>
        <StackPane fx:id="content" style="-fx-background-color: white;">
            <children>
                <VBox spacing="8" alignment="CENTER">
                    <Label text="Selecciona un proyecto"
                           style="-fx-text-fill: #4b5563; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Los módulos se cargarán aquí"
                           style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                </VBox>
            </children>
        </StackPane>
    </center>
    <bottom>
        <HBox spacing="10"
              style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0; -fx-alignment: center-left;">
            <padding>
                <Insets top="6" right="12" bottom="6" left="12"/>
            </padding>
            <Label fx:id="statusLabel" text="Listo."/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="v1.0"/>
        </HBox>
    </bottom>

</BorderPane>
